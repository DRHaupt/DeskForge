# ─────────────────────────────────────────────────────────────────────────────
# DeskForge environment — secrets and infrastructure ONLY.
# Everything business-specific (name, colors, workflows, SLAs…) lives in
# business.config.yaml. Copy this file to .env and fill in the blanks.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL people use to reach the help desk (no trailing slash).
APP_BASE_URL=http://localhost:3000

# Session/encryption secret. Generate with: openssl rand -base64 48
AUTH_SECRET=

# ─── Database & Redis (docker compose builds the URLs from these) ───────────
POSTGRES_USER=deskforge
POSTGRES_PASSWORD=
POSTGRES_DB=deskforge
# Only needed when running outside docker compose:
# DATABASE_URL=postgresql://deskforge:password@localhost:5432/deskforge
# REDIS_URL=redis://localhost:6379

# ─── Docker compose ─────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=deskforge
# Where the app port is published. Keep 127.0.0.1 when a reverse proxy runs on the host.
APP_BIND=127.0.0.1
APP_PORT=3000
# Image to run. Leave as-is to build from source; set to a registry tag for prebuilt images.
DESKFORGE_IMAGE=deskforge:local
# Path to the DeskForge source (used when building). Set by scripts/new-business.sh.
DESKFORGE_SRC=.
# Domain for the optional Caddy reverse proxy (`--profile caddy`).
DOMAIN=localhost
# Caddy config in deploy/: Caddyfile (automatic Let's Encrypt) or
# Caddyfile.cloudflare (behind the Cloudflare proxy, with an origin certificate).
CADDYFILE=Caddyfile
# Cloudflare Tunnel token for `--profile cloudflared` (Zero Trust → Networks → Tunnels).
TUNNEL_TOKEN=
# Read the visitor IP from this header. Set to cf-connecting-ip when using a Cloudflare Tunnel.
CLIENT_IP_HEADER=

# ─── First run ──────────────────────────────────────────────────────────────
# Load realistic demo data on startup (only seeds an empty database).
SEED_DEMO_DATA=false
# Initial admin account created by the seed (password must meet the config's password policy).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ─── Logging & limits ───────────────────────────────────────────────────────
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=300
UPLOAD_MAX_MB=25
# Comma-separated MIME types / extensions allowed for attachments (empty = safe default list).
UPLOAD_ALLOWED_TYPES=

# ─── File storage ───────────────────────────────────────────────────────────
# local = Docker volume (default); s3 = any S3-compatible service (MinIO, Backblaze B2, AWS…)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ─── Outbound email (SMTP) ──────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# ─── Inbound email ──────────────────────────────────────────────────────────
# IMAP mailboxes: one block per `imapEnvPrefix` in business.config.yaml, e.g. IMAP_HELP:
# IMAP_HELP_HOST=imap.example.com
# IMAP_HELP_PORT=993
# IMAP_HELP_USER=help@example.com
# IMAP_HELP_PASSWORD=
# IMAP_HELP_TLS=true
# Shared secret for the inbound webhook (/api/inbound/email?secret=...) used by Mailgun/Postmark-style providers.
INBOUND_EMAIL_SECRET=

# ─── Single sign-on (OIDC) ──────────────────────────────────────────────────
# One block per provider listed under auth.oidc in business.config.yaml (by envPrefix).
# Microsoft Entra ID: ISSUER is https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_ENTRA_CLIENT_ID=
# OIDC_ENTRA_CLIENT_SECRET=
# OIDC_ENTRA_ISSUER=
# Google:
# OIDC_GOOGLE_CLIENT_ID=
# OIDC_GOOGLE_CLIENT_SECRET=
